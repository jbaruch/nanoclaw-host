{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "tessl hook run --plugin-path=\".tessl/plugins/jbaruch/coding-policy\" --event=\"sessionStart\" --agent=cursor --schema-version=1"
      }
    ]
  },
  "tessl": {
    "hooks": {
      "jbaruch/coding-policy": [
        {
          "nativeEvent": "sessionStart",
          "hookEntry": {
            "command": "tessl hook run --plugin-path=\".tessl/plugins/jbaruch/coding-policy\" --event=\"sessionStart\" --agent=cursor --schema-version=1"
          }
        }
      ]
    }
  }
}
